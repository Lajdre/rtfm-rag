###### Required fields
OPENAI_API_KEY=


###### Optional fields with defaults

### GENERATOR_MODEL_PROVIDER
# Choose the model provider: "openai" or "ollama"
# GENERATOR_MODEL_PROVIDER=openai
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="gemma3:270m"

### AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_REGION=

### Logging Configuration
# Log level: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
# LOG_LEVEL="INFO"
# Optional: path to log file (leave empty for stdout only)
# LOG_FILE=""
# Log format: "console" or "json"
# LOG_FORMAT="console"

### PostgreSQL connection details
# DB_HOST="localhost"
# DB_PORT=5432
# DB_NAME="rtfm-rag"
# DB_USER="developer"
# DB_PASSWORD="password"

### Server Configuration
# SERVER_HOST="0.0.0.0"
# SERVER_PORT=8032
# SERVER_DEBUG_MODE=False

### Project metadata
# PROJECT_NAME="RTFM RAG"
# API_VERSION="0.1.0"
# API_V1_STR="/api/v1"
